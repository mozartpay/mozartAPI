{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./",      
    "outDir": "./dist",
    "moduleResolution": "Node",                                           
    "typeRoots": ["./@types", "./node_modules/@types"],                                 
    "types": ["node"],      
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,            
    "esModuleInterop": true, 
    "forceConsistentCasingInFileNames": true, 
    "strict": true, 
    "skipLibCheck": true 
  },
  "include": ["./**/*.ts", "test.ts"],
  "exclude": ["node_modules", "dist"]
}
